# --- Database ---
DATABASE_URL=postgres://empire:empire@localhost:5432/empire
# Integration tests TRUNCATE tables — they run against a dedicated database
# (created by infra/postgres-init/ on first `docker compose up`).
TEST_DATABASE_URL=postgres://empire:empire@localhost:5432/empire_test

# --- Logging ---
LOG_LEVEL=info

# --- Bot tokens (one Discord application per bot) ---
MERCHANT_TOKEN=
BUILDER_TOKEN=
HERALD_TOKEN=
ARCHITECT_TOKEN=
TAVERN_TOKEN=
SECRET_MERCHANT_TOKEN=
EXCHANGE_TOKEN=
OPS_TOKEN=

# --- LLM-worded dialogue (§5.4/§11) — the Secret Merchant's /approach line ---
# Optional: with no key, /approach falls back to authored lines (zero cost).
ANTHROPIC_API_KEY=
# Optional overrides: model tier + a hard hourly ceiling on real generations.
DIALOGUE_MODEL=claude-haiku-4-5
DIALOGUE_MAX_PER_HOUR=30

# --- Dev guilds (the three-continent ring + one dungeon-pool server minimum) ---
# Every bot needs an invite to all three; continents.yaml wires them into a ring
# where each neighbours the other two.
GUILD_CONTINENT_ONE=
GUILD_CONTINENT_TWO=
GUILD_CONTINENT_THREE=
GUILD_DUNGEON_POOL_ONE=
